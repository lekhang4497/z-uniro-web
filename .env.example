# Public URL of the UniRo backend. Baked into both web and desktop builds at
# build time; can be overridden per-user at runtime in Settings → Backend.
# The web deployment must set this to the production backend. Leave unset in
# dev to default to http://localhost:8857.
NEXT_PUBLIC_BACKEND_URL=

# Supabase auth (web only). Both values are publishable — safe to ship in
# the browser bundle. The dashboard's allowed redirect URLs must include
# the deployed origins (e.g. http://localhost:3000/auth/callback,
# https://www.uniro.tech/auth/callback) for the OAuth flow to complete.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin role lives in Supabase: public.profiles.is_admin (set by another
# admin via the dashboard or a SQL UPDATE — see migration
# 20260507_create_profiles_with_admin_role). No env var needed.
